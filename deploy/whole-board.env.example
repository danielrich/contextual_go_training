# Example paths only. Edit the installed /etc/whole-board/whole-board.env.
WB_HOST=0.0.0.0
WB_PORT=8443
WB_STATIC_DIR=/opt/whole-board/static
WB_DATA_DIR=/var/lib/whole-board
WB_DB=/var/lib/whole-board/trainer.sqlite

# A trusted certificate for the server hostname used on your phone.
# An existing certificate can be reused at a separate port.
WB_TLS_CERT=/path/to/server-certificate.pem
WB_TLS_KEY=/path/to/server-private-key.pem

# May point to an existing executable CUDA wrapper that forwards arguments.
WB_KATAGO_BIN=/path/to/katago-or-cuda-wrapper
WB_KATAGO_MODEL=/path/to/model.bin.gz
WB_KATAGO_VISITS=200
WB_ENGINE_TIMEOUT=120
